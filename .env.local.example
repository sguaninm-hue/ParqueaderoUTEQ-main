# Copia este archivo a .env.local y completa con tus propios valores.
# .env.local está en .gitignore: nunca subas credenciales reales al repositorio.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Endpoint REST de reconocimiento de placas (vista Monitoreo de entrada)
VITE_OCR_ENDPOINT=https://tu-servicio-ocr.azurewebsites.net/api/detectar-placa?code=tu-codigo

# Otros (opcionales)
VITE_APP_NAME=UTEQ Smart Parking
VITE_APP_VERSION=1.0.0
